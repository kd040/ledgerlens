# LedgerLens backend configuration. Copy to .env and fill in real values.
# Never commit a filled-in .env -- it is gitignored on purpose.

# --- Database (Supabase Postgres) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_DB_URL=

# --- Razorpay Test Mode data source ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- AI Investigator ---
# AI_PROVIDER selects the PRIMARY provider: "gemini" (default) or "anthropic".
AI_PROVIDER=gemini

# Primary provider key. Required for the AI Investigator to run at all.
GEMINI_API_KEY=
# Only needed when AI_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# Fallback provider. OPTIONAL but recommended in production: when the
# primary provider fails transiently (503 "high demand", 429 rate limit,
# timeout), LedgerLens retries it once and then falls back to Groq rather
# than surfacing a provider outage to the user. Leave blank to disable
# failover -- the primary still gets its one retry.
# Read only by the backend; never sent to the frontend.
GROQ_API_KEY=

# Optional model overrides -- each defaults to the value in app/ai/config.py.
# GEMINI_MODEL=
# ANTHROPIC_MODEL=
# GROQ_MODEL=

# --- Demo account seeding (backend/scripts/seed_demo_users.py) ---
# REQUIRED before running the seed script. It has no built-in defaults, so
# that no working credential is ever committed to this repository; seeding
# fails with a configuration error if either is unset.
DEMO_ANALYST_PASSWORD=
DEMO_REVIEWER_PASSWORD=

# --- Deployment ---
# Set to "production" on Render: switches the session cookie to
# SameSite=None; Secure for the cross-site Vercel -> Render call.
ENV=development
