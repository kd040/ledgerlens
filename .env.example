SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_DB_URL=""

# Comma-separated list of origins allowed to call the API (CORS).
# Defaults to the local Vite dev server if unset.
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Razorpay Test Mode API credentials (server-side only -- never expose
# these to the frontend). Get them from the Razorpay Dashboard in Test
# Mode: Settings > API Keys.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Passwords for the two seeded demo accounts (backend/scripts/seed_demo_users.py).
# REQUIRED before seeding: the script has no built-in defaults, so that no
# working credential is ever committed to this repository. Seeding fails
# with a configuration error if either is unset.
DEMO_ANALYST_PASSWORD=""
DEMO_REVIEWER_PASSWORD=""

# "production" makes the session cookie Secure (HTTPS only). Unset/anything
# else keeps it usable over plain http:// for local development.
ENV=""

# AI Investigator (backend/app/ai/) -- server-side only, never exposed to
# the frontend. Selects which provider (backend/app/ai/providers/) runs:
# "gemini" or "anthropic". Defaults to "gemini" if unset.
AI_PROVIDER=""

# Get a key from console.anthropic.com.
ANTHROPIC_API_KEY=""

# Overrides the default model (see backend/app/ai/config.py) without any
# code change -- e.g. to compare a cheaper/faster model.
ANTHROPIC_MODEL=""

# Get a key from aistudio.google.com/apikey.
GEMINI_API_KEY=""

# Overrides the default model (see backend/app/ai/config.py) without any
# code change.
GEMINI_MODEL=""